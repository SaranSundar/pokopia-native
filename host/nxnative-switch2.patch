+            if (need >= 0.5 * look_dead() * cap) { double m = look_dead() + 0.005; g_look_axes[0] = (int32_t)lrint(ax / need * m * DM_STICK_MAX); g_look_axes[1] = (int32_t)lrint(ay / need * m * DM_STICK_MAX); }
