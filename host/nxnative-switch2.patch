+// ---------- the node ----------
+#define LDN_NETINFO 0x480
+#define LDN_NODES 8
+#define LDN_ADV_MAX 0x180
+#define VIP_PREFIX 0xA9FE0000u    // 169.254.0.0
+#define VQ COOP_QUEUE_MAX
