diff --git a/dm/host/hle_os.c b/dm/host/hle_os.c
index 2d1afec..175a67a 100644
--- a/dm/host/hle_os.c
+++ b/dm/host/hle_os.c
@@ -54,6 +54,15 @@ static int detclock_cfg(void) {
 }
 static uint64_t wall_guest_ns(void) { return atomic_load(&g_gfz) ? atomic_load(&g_gfrozen) : now_ns() - atomic_load(&g_glag); }
 uint64_t guest_ns(void) { return atomic_load(&g_gdet_on) ? atomic_load(&g_gdet) : wall_guest_ns(); }
+// SWITCH2 (private bring-up): the Switch 2 system counter runs at 31.25 MHz (Eden-NS2 guest_clock.h GetGuestCounterFrequency), the Tegra X1's at 19.2 MHz.
+// The SDK converts ticks with its constant, so the 19.2 MHz counter ran Pokopia's clock at 61.4 %: a 27.1 ms frame from its 60 fps limiter, animations 1.63x slow.
+// Every guest-visible counter (the cntpct / cntvct gate, svc GetSystemTick) comes from here. DM_TICK_HZ overrides (19200000 = the Tegra X1 counter).
+uint64_t guest_ticks(void) {
+    static uint64_t hz;
+    if (!hz) { const char *e = getenv("DM_TICK_HZ"); uint64_t v = e ? strtoull(e, 0, 0) : 31250000ull; if (!v) v = 31250000ull; hz = v;
+               LOG("guest system counter %llu Hz (%s)", (unsigned long long)hz, e ? "DM_TICK_HZ" : "Switch 2 default"); }
+    return (uint64_t)(((__uint128_t)guest_ns() * hz) / 1000000000ull);
+}
 int dm_detclock_enabled(void) { return detclock_cfg() && atomic_load(&g_gdet_on); }
 void dm_guest_frame_tick(void) {
     crash_watch_frame();
diff --git a/dm/host/hle_svc.c b/dm/host/hle_svc.c
index 4f440a0..32498e1 100644
--- a/dm/host/hle_svc.c
+++ b/dm/host/hle_svc.c
@@ -654,7 +654,7 @@ uint64_t svc_dispatch(int num, uint64_t *regs, uint64_t orig_addr) {
         if (regs[0] & 0x80000000ull) return 0;   // notification only, can continue
         _exit(42);
     }
-    case 0x1E: guest_clock_read_wait(); regs[0] = 0; regs[1] = guest_ns() * 12 / 625; return 0;   // GetSystemTick
+    case 0x1E: { uint64_t guest_ticks(void); guest_clock_read_wait(); regs[0] = 0; regs[1] = guest_ticks(); return 0; }   // GetSystemTick (hle_os.c: the guest system counter)
     case 0x27: {  // OutputDebugString(str, len)
         if (g_flag.dbg) fprintf(stderr, "[guest] %.*s\n", (int)regs[1], (char *)regs[0]);
         regs[0] = 0; return 0;
@@ -686,6 +686,10 @@ uint64_t svc_dispatch(int num, uint64_t *regs, uint64_t orig_addr) {
         // left its main thread waiting at boot for a thread it never created (main+0x3e1ac4)
         case I_FreeThreadCount: { int thr_limit_used(void); int u = thr_limit_used(); v = u < 96 ? 96 - u : 0; break; }
         case I_UserExcAddr: { static _Alignas(0x1000) uint8_t ctx[0x1000]; v = (uint64_t)ctx; break; }   // user exception context area: newer SDKs' SetDyingMessageRegion writes to +0x1c0 (0 would write through a null pointer)
+        // SWITCH2 (private fork): the extended SDK's RemoteRegionManager / VAMM queries (ids 29..33). Eden-NS2 answers 0 for
+        // the remote region/memory ids (no remote mappings) and the page granule for 33; the host maps in 16 KB pages.
+        case 29: case 30: case 31: case 32: v = 0; break;
+        case 33: v = 0x4000; break;
         default: v = 0; break;
         }
         regs[0] = 0; regs[1] = v; return 0;
