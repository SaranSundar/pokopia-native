# ctest coop.play_builds: play.ps1's $CoopBuilds (the Link Play window greys out the co-op switches for other game versions) names the same main builds as
# coop_interact.c's site tables. cmake -DREPO=<repository> -P play_builds.cmake
file(READ "${REPO}/src/coop/coop_interact.c" c)
file(READ "${REPO}/scripts/play.ps1" p)
foreach (t g_sites g_story)
    string(REGEX MATCH "${t}.. = {[^;]*}" tab "${c}")
    string(REGEX MATCHALL "{\"[0-9a-f]+\"" ids "${tab}")
    string(REGEX REPLACE "{\"" "" ids "${ids}")
    string(REGEX REPLACE "\"" "" ids "${ids}")
    list(REMOVE_DUPLICATES ids)
    list(SORT ids)
    set(${t} "${ids}")
endforeach ()
string(REGEX MATCH "[$]CoopBuilds = .ordered.@{[^}]*}" line "${p}")
string(REGEX MATCHALL "'[0-9a-f]+' =" ps "${line}")
string(REGEX REPLACE "'| =" "" ps "${ps}")
list(SORT ps)
if (NOT g_sites OR NOT "${g_sites}" STREQUAL "${g_story}" OR NOT "${g_sites}" STREQUAL "${ps}")
    message(FATAL_ERROR "co-op builds differ: Interact everywhere [${g_sites}], Story co-op [${g_story}], play.ps1 [${ps}]")
endif ()
message(STATUS "co-op builds alike: ${ps}")
