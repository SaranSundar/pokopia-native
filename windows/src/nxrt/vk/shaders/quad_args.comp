#version 450
// An indirect quad draw's NVN arguments (vertex count, instance count, first vertex, base instance) as an indexed indirect draw over the quad index buffer
// (index count, instance count, first index, vertex offset, first instance), made on the GPU after the commands that write them (vk_replay.c quad_args).
// At most 65536 quads and 65536 instances: a count that is not there yet must not keep the GPU busy past Windows' timeout (#17, #20)
layout(local_size_x = 1) in;
layout(std430, set = 0, binding = 0) readonly buffer Src { uint src[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Dst { uint dst[5]; };
layout(push_constant) uniform Pc { uint at; } pc;   // the arguments' first word in Src
void main() {
    uint v = src[pc.at], n = src[pc.at + 1u];
    dst[0] = min(v / 4u, 65536u) * 6u;
    dst[1] = min(n, 65536u);
    dst[2] = 0u;
    dst[3] = src[pc.at + 2u];
    dst[4] = src[pc.at + 3u];
}
