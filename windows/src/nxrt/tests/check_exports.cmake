# nxrt.exports (#30): the dynamic symbols nxrt defines are game.so's imports only, rt_* and adapter_* (plat/linux/nxrt.dynlist), and the few the
# linker and the C start-up files always put there. Above all no Vulkan entry point's name: an exported vk* takes the loader's own references
#   cmake -DNM=<nm> -DEXE=<nxrt> -P check_exports.cmake
execute_process(COMMAND ${NM} -D --defined-only ${EXE} OUTPUT_VARIABLE out RESULT_VARIABLE rc)
if(rc)
  message(FATAL_ERROR "${NM} -D failed on ${EXE}")
endif()
string(REPLACE "\n" ";" lines "${out}")
set(n 0)
set(vk "")
set(other "")
foreach(l IN LISTS lines)
  if(NOT l MATCHES " ([^ ]+)$")
    continue()
  endif()
  string(REGEX REPLACE "@.*" "" s "${CMAKE_MATCH_1}")
  math(EXPR n "${n} + 1")
  if(s MATCHES "^vk[A-Z]")
    list(APPEND vk "${s}")
  elseif(NOT s MATCHES "^(rt_|adapter_)" AND NOT s MATCHES "^(_IO_stdin_used|__bss_start|_edata|_end|_init|_fini|__data_start|data_start)$")
    list(APPEND other "${s}")
  endif()
endforeach()
list(LENGTH vk nvk)
list(LENGTH other nother)
if(nvk OR nother)
  list(SUBLIST vk 0 10 vk10)
  list(SUBLIST other 0 10 other10)
  message(FATAL_ERROR "${EXE} exports ${nvk} Vulkan names (${vk10}) and ${nother} others beyond rt_* and adapter_* (${other10})")
endif()
message(STATUS "${EXE}: ${n} exported symbols, all rt_*, adapter_* or the linker's own")
